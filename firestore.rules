rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() == 'ajnovasistemas@gmail.com'
      );
    }

    function isDocumentOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Aprobación del creador: lo nuevo entra "pendiente" y solo el creador cambia ese estado
    function createsPending() {
      return request.resource.data.approvalStatus == 'pending';
    }
    function keepsApproval() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvalStatus', 'approvalNote', 'approvalDecidedAt']);
    }

    // 1. PUBLIC CATALOGS: Public read, owner-only write, admin full access
    
    // Workers collection (Directorio de Profesionales de Oficios)
    match /workers/{workerId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() && createsPending() && (
          request.resource.data.ownerUid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.createdBy == request.auth.uid
        )
      );
      allow update: if isAdmin() || (
        isSignedIn() && keepsApproval() && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        )
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        )
      );
    }

    // Shops collection (Comercios y Negocios Adheridos)
    match /shops/{shopId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() && createsPending() && (
          request.resource.data.ownerUid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.createdBy == request.auth.uid
        )
      );
      allow update: if isAdmin() || (
        isSignedIn() && keepsApproval() && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        )
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        )
      );
    }

    // Merchants collection (ServiGo Delivery: locales de comida)
    // Cada local pertenece a una cuenta (ownerUid). Nunca se guardan contraseñas.
    match /merchants/{merchantId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isAdmin() || (
          request.resource.data.ownerUid == request.auth.uid &&
          createsPending() &&
          !request.resource.data.keys().hasAny(['accountPassword', 'accountUsername', 'accountEmail'])
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.ownerUid == request.auth.uid &&
          keepsApproval() &&
          request.resource.data.ownerUid == request.auth.uid &&
          !request.resource.data.keys().hasAny(['accountPassword', 'accountUsername', 'accountEmail'])
        )
      );
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Rental Items collection (ServiGo Alquiler de Productos - Catálogo Público)
    match /rental_items/{itemId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() && createsPending() && (
          request.resource.data.ownerUid == request.auth.uid ||
          request.resource.data.ownerId == request.auth.uid ||
          request.resource.data.createdBy == request.auth.uid
        )
      );
      allow update: if isAdmin() || (
        isSignedIn() && keepsApproval() && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.ownerId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        )
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.ownerId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        )
      );
    }

    // Banners collection (Banners de Publicidad y Auspicios)
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App Configuration collection (Ajustes del sistema y visibilidad de pestañas)
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons collection (Cupones de Descuento en Comercios y Bruzzone)
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin() || (
        isSignedIn() && (
          resource.data.createdBy == request.auth.uid ||
          request.resource.data.createdBy == request.auth.uid
        )
      );
    }

    // Job Profiles & CVs collection (Bolsa de Trabajo)
    match /job_profiles/{profileId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() && createsPending() && (
          request.resource.data.ownerUid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.createdBy == request.auth.uid
        )
      );
      allow update: if isAdmin() || (
        isSignedIn() && keepsApproval() && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        )
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        )
      );
    }

    // Remises & Conductores collection
    match /remises/{remisId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() && createsPending() && (
          request.resource.data.ownerUid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.createdBy == request.auth.uid
        )
      );
      allow update: if isAdmin() || (
        isSignedIn() && keepsApproval() && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        )
      );
      allow delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        )
      );
    }

    // 2. SERVIDORES Y BILLETERAS: Escritura prohibida al cliente, gestionada únicamente por Admin SDK en server.ts
    
    // Rental Wallets & Transactions (Billeteras de locadores)
    match /rental_wallets/{walletId} {
      allow read: if isSignedIn() && (
        walletId == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false; // Solo servidor backend con Admin SDK
    }

    // Rental Payout Requests (Retiros de Billetera a CBU/Alias)
    match /rental_payouts/{payoutId} {
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false; // Solo servidor backend con Admin SDK
    }

    // 3. PII Y DATOS SENSIBLES: Solo el propio usuario y admin leen DNI, CBU y perfil privado

    // Rental Owners / Locadores Registrados (Contiene DNI, CBU/Alias bancario)
    match /rental_owners/{ownerId} {
      allow read: if isSignedIn() && (
        ownerId == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        (
          (ownerId == request.auth.uid ||
          request.resource.data.ownerUid == request.auth.uid ||
          request.resource.data.createdBy == request.auth.uid)
          && !request.resource.data.keys().hasAny(['walletBalance', 'pendingBalance', 'totalEarned'])
        ) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() || (
          (ownerId == request.auth.uid || resource.data.ownerUid == request.auth.uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'walletBalance', 'pendingBalance', 'totalEarned'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // Rental Owner Secrets (Tokens privados de OAuth Mercado Pago - Solo servidor con Admin SDK)
    match /rental_owner_secrets/{ownerId} {
      allow read, write: if false; // Solo servidor backend con Admin SDK
    }

    // Users collection (Perfiles de usuarios y datos de contacto)
    match /users/{userId} {
      allow read: if isSignedIn() && (
        userId == request.auth.uid ||
        isAdmin()
      );
      // El usuario no puede ponerse ni sacarse el bloqueo (lo maneja el servidor)
      allow create: if isAdmin() || (
        isSignedIn() && userId == request.auth.uid &&
        !request.resource.data.keys().hasAny(['blocked', 'blockedReason', 'blockedAt'])
      );
      allow update: if isAdmin() || (
        isSignedIn() && userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['blocked', 'blockedReason', 'blockedAt'])
      );
      allow delete: if isAdmin();
    }

    // 4. TRANSACCIONES Y RESERVAS: Acceso restringido a las partes involucradas (cliente / dueño / admin)

    // Rental Bookings collection (Alquileres temporarios entre pares)
    match /rental_bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.clientUid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      // El cliente ya no puede crear reservas directamente; las crea el servidor Admin SDK en /api/rentals/checkout
      allow create: if false;
      // El cliente NO puede alterar campos financieros (paymentStatus, depositStatus, comisiones, montos)
      allow update: if isSignedIn() && (
        isAdmin() || (
          (
            resource.data.clientUid == request.auth.uid ||
            resource.data.ownerUid == request.auth.uid ||
            resource.data.ownerId == request.auth.uid
          )
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'paymentStatus', 'depositStatus', 'platformFeeRate', 'platformFeeAmount', 'ownerNetAmount', 'totalPrice',
            'status', 'entrega', 'devolucion', 'damageReport', 'lateFeeRetained', 'depositRefunded', 'closedAt'
          ])
        )
      );
      allow delete: if isAdmin();

      // Fotos de las actas de entrega y devolución: solo las ven las partes; las sube el servidor
      match /evidencias/{photoId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/rental_bookings/$(bookingId)).data.clientUid == request.auth.uid ||
          get(/databases/$(database)/documents/rental_bookings/$(bookingId)).data.ownerUid == request.auth.uid ||
          get(/databases/$(database)/documents/rental_bookings/$(bookingId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
        allow write: if false;
      }
    }

    // Bookings collection (Solicitudes de servicios para profesionales)
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.clientUid == request.auth.uid ||
        resource.data.workerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.clientUid == request.auth.uid ||
        resource.data.workerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Orders collection (Pedidos de ServiGo Delivery)
    // Lo ven y lo actualizan solo el cliente que pidió y el dueño del local.
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.clientUid == request.auth.uid ||
        resource.data.merchantOwnerUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.clientUid == request.auth.uid &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.merchantOwnerUid ==
          get(/databases/$(database)/documents/merchants/$(request.resource.data.merchantId)).data.ownerUid;
      allow update: if isSignedIn() && (
        isAdmin() || (
          (resource.data.clientUid == request.auth.uid || resource.data.merchantOwnerUid == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'clientUid', 'clientId', 'merchantOwnerUid', 'merchantId', 'items', 'itemsTotal', 'total', 'deliveryFee', 'extraDeliveryFee'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // Ride Requests collection (Viajes y remises)
    match /ride_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Issued Vouchers collection (cupones de descuento)
    // Los de alquiler (source == 'rental') los emite solo el servidor.
    // El canje lo hace el creador (o el servidor). Nadie puede reactivar un cupón usado.
    match /issued_vouchers/{voucherId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.workerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.status == 'active' &&
        (!('source' in request.resource.data) || request.resource.data.source != 'rental')
      );
      allow update, delete: if isAdmin();
    }

    // Cadetes (mandados y traslados)
    match /cadetes/{cadeteId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() && createsPending() && request.resource.data.ownerUid == request.auth.uid
      );
      allow update: if isAdmin() || (
        isSignedIn() && keepsApproval() && resource.data.ownerUid == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Pedidos a cadetes
    match /cadete_requests/{requestId} {
      allow read, create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Deny all other unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
